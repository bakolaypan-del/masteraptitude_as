rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bakolaypan@gmail.com' ||
        (request.auth.token.role != null && request.auth.token.role == 'admin') ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Profiles: users read/write their own profile; admins can read/write any
    match /profiles/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Test Results: user can read/write their own test results
    match /users/{userId}/test_results/{resultId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Leaderboards: signed-in users can read, user can write their own score
    match /leaderboards/{entry} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // System Settings & Notifications: only admins can write, signed-in users can read
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Questions / Tests / PYQs / Job Notifications: admins full control, signed-in users read
    match /mock_tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /pyqs/{pyqId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /one_liners/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /job_notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /typing_tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /typing_results/{resultId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /paid_mocks/{mockId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /news_posts/{postId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /mock_question_analysis/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /custom_categories/{catId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Village League Tournament Rules (Public Read, Create, Update & Delete allowed)
    match /village_league_teams/{teamId} {
      allow read, create, update, delete: if true;
    }

    match /village_league_players/{playerId} {
      allow read, create, update, delete: if true;
    }

    match /village_league_registrations/{regId} {
      allow read, create, update, delete: if true;
    }

    match /settings/village_league {
      allow read, write: if true;
    }
  }
}
